#!name=Domestic App DNS
#!desc=Routes DouYin directly and uses System DNS for selected domestic services.

[Rule]
# DouYin and ByteDance
DOMAIN,lf3-static.bytednsdoc.com,DIRECT
DOMAIN,v5-dy-o-abtest.zjcdn.com,DIRECT
DOMAIN-SUFFIX,amemv.com,DIRECT
DOMAIN-SUFFIX,bytecdn.com,DIRECT
DOMAIN-SUFFIX,byteeffecttos.com,DIRECT
DOMAIN-SUFFIX,bytegecko.com,DIRECT
DOMAIN-SUFFIX,bytehwm.com,DIRECT
DOMAIN-SUFFIX,byteimg.com,DIRECT
DOMAIN-SUFFIX,bytedance.com,DIRECT
DOMAIN-SUFFIX,bytemaimg.com,DIRECT
DOMAIN-SUFFIX,bytemastatic.com,DIRECT
DOMAIN-SUFFIX,bsgslb.cn,DIRECT
DOMAIN-SUFFIX,douyincdn.com,DIRECT
DOMAIN-SUFFIX,douyinpic.com,DIRECT
DOMAIN-SUFFIX,douyinstatic.com,DIRECT
DOMAIN-SUFFIX,douyinvod.com,DIRECT
DOMAIN-SUFFIX,ecombdapi.com,DIRECT
DOMAIN-SUFFIX,ecombdimg.com,DIRECT
DOMAIN-SUFFIX,huoshanimg.com,DIRECT
DOMAIN-SUFFIX,idouyinvod.com,DIRECT
DOMAIN-SUFFIX,ixigua.com,DIRECT
DOMAIN-SUFFIX,ixiguavideo.com,DIRECT
DOMAIN-SUFFIX,ndcpp.com,DIRECT
DOMAIN-SUFFIX,ndcppx.com,DIRECT
DOMAIN-SUFFIX,pstatp.com,DIRECT
DOMAIN-SUFFIX,qishui.com,DIRECT
DOMAIN-SUFFIX,rtcxyz.com,DIRECT
DOMAIN-SUFFIX,snssdk.com,DIRECT
DOMAIN-SUFFIX,toutiao.com,DIRECT
DOMAIN-SUFFIX,zijieapi.com,DIRECT

[Host]
# XiaoHongShu
*.xiaohongshu.com=server:https://dns.alidns.com/dns-query
*.xhscdn.com=server:https://dns.alidns.com/dns-query
*.xhscdn.net=server:https://dns.alidns.com/dns-query
*.rednotecdn.com=server:https://dns.alidns.com/dns-query
*.rnote.com=server:https://dns.alidns.com/dns-query
sa.ksrd.xyz=server:https://dns.alidns.com/dns-query
*.yunjnet.com=server:system

# LiteNext
*.litenext.digital=server:system

# Apple and iCloud
*.apple.com=server:system
*.icloud.com=server:system
*.mzstatic.com=server:system
*.cdn-apple.com=server:system
*.icloud-content.com=server:system

# Kelee plugin resources
kelee.one=server:system
hub.kelee.one=server:system

# WeChat and QQ
*.qq.com=server:system
*.weixin.qq.com=server:system
*.wxs.qq.com=server:system
*.qpic.cn=server:system
*.qlogo.cn=server:system
*.gtimg.com=server:system

# Weibo
*.weibo.com=server:system
*.weibo.cn=server:system
*.sinaimg.cn=server:system
*.sinacloud.net=server:system
*.weibocdn.com=server:system

# Amap and AutoNavi
*.amap.com=server:system
*.autonavi.com=server:system

# Alibaba and Alipay
*.alipay.com=server:system
*.alicdn.com=server:system
*.aliyuncs.com=server:system
*.alibabachengdun.com=server:system
*.alibabachengdun.net=server:system
*.tanx.com=server:system
*.ele.me=server:system
*.taobao.com=server:system

# Meituan and Dianping
*.meituan.com=server:system
*.meituan.net=server:system
*.dianping.com=server:system

# Pinduoduo
*.pinduoduo.com=server:system
*.pddpic.com=server:system

# JD
*.jd.com=server:system
*.360buyimg.com=server:system

# China Mobile authentication
*.cmpassport.com=server:system

# Huawei services
*.hicloud.com=server:system
*.dbankcloud.cn=server:system

# Other domestic service domains observed in the log
*.baidu.com=server:system
*.bdstatic.com=server:system
*.bcebos.com=server:system
*.tencent.com=server:system
m.baike.com=server:system
*.300hu.com=server:system
*.kuaishouzt.com=server:system
*.ksyun.com=server:system
*.livehwc3.cn=server:system
*.taou.com=server:system
*.maimai.cn=server:system
*.sobot.com=server:system
*.gepush.com=server:system
*.shuzilm.cn=server:system
*.trtcube-license.cn=server:system
*.tencent-cloud.net=server:system

# Xiaomi and smart-home services
*.xiaomi.com=server:system
*.mi.com=server:system
*.mi-img.com=server:system
*.mijia.tech=server:system
*.xiaomi.net=server:system

# Alibaba delivery and payment assets
*.cainiao.com=server:system
*.mmstat.com=server:system
*.alipayobjects.com=server:system

# China Merchants Bank
*.cmbchina.com=server:system
*.cmbimg.com=server:system

# Zhihu
*.zhihu.com=server:system
*.zhimg.com=server:system

# Bilibili and its domestic CDN/API domains
*.bilibili.com=server:system
*.bilivideo.com=server:system
*.bilivideo.cn=server:system
*.biliapi.com=server:system
*.biliapi.net=server:system
*.hdslb.com=server:system
*.b23.tv=server:system

# NetEase and 163/126 CDN domains
*.163.com=server:system
*.126.net=server:system
*.netease.com=server:system
*.netease.com.cn=server:system
*.netease.im=server:system
*.nosdn.127.net=server:system
*.music.126.net=server:system

# DeepSeek
*.deepseek.com=server:system
*.deepseek.cn=server:system

# Domestic cloud/CDN domains frequently used by Chinese apps
*.volces.com=server:system
*.volcengine.com=server:system
*.volceapplog.com=server:system
*.qcloud.com=server:system
*.qcloudimg.com=server:system
*.qcloudcos.com=server:system

# Catch Chinese ccTLD domains not listed above.
*.cn=server:system

# DouYin and ByteDance
*.amemv.com=server:https://dns.alidns.com/dns-query
*.bytednsdoc.com=server:https://dns.alidns.com/dns-query
*.douyincdn.com=server:https://dns.alidns.com/dns-query
